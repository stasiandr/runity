// What a cook does, by name: WASD (or the stick) walks, E grabs, F chops,
// Q throws food, G points ("here!"). Rebind here, and a running game picks it up.
(
    actions: {
        "quit": [Key(Escape)],
        "profile": [Key(F3)],
        "restart": [Key(R), Pad(Start)],
        "grab": [Key(E), Key(Space), Pad(South)],
        "work": [Key(F), Pad(West)],
        "throw": [Key(Q), Pad(East)],
        "ping": [Key(G), Pad(North)],
    },
    axes: {
        "forward": (negative: [Key(S), Key(Down)], positive: [Key(W), Key(Up)], analog: [LeftY]),
        "right": (negative: [Key(A), Key(Left)], positive: [Key(D), Key(Right)], analog: [LeftX]),
    },
)
