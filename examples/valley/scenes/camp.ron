// Два костра, собранные из одного префаба, и третий — с переопределённым
// материалом. Сцена про то, что вещь, построенную один раз, ставят много раз:
// поправьте `prefabs/campfire.prefab`, и поменяются все три.
//
// Префабы ищутся в каталоге `prefabs/` рядом со сценой — и scene_shot, и
// walk, и редактор смотрят туда.
(
    view: (position: (0.0, 2.4, 6.0), target: (0.0, 0.3, -1.6), fov_deg: 55.0),
    sun: (hour: 8.0, intensity: 1.05),
    fog: (color: (0.62, 0.68, 0.74), start: 20.0, end: 120.0),
    entities: [
        (
            id: "5cb7dd5af41540fa",
            name: "ground",
            model: "builtin:plane",
            transform: (scale: (120.0, 1.0, 120.0)),
            material: "grass",
        ),

        // Один и тот же костёр, расставленный по-разному. Имя и место — от
        // экземпляра, всё остальное — от префаба.
        // Огонь светит: у горящих костров рядом с угольком лампа — тёплая,
        // с тенями от камней. У потухшего её нет.
        (id: "876b198bbedf5219", name: "west fire", model: "", prefab: "campfire", transform: (position: (-3.2, 0.01, 0.0)), children: [
            (id: "e1c5a7b3d9f02468", name: "flame", transform: (position: (0.0, 0.55, 0.0)), light: (color: (1.0, 0.52, 0.2), intensity: 3.5, range: 7.0)),
        ]),
        (id: "79c8ecaf7992dda2", name: "east fire", model: "", prefab: "campfire", transform: (position: (3.2, 0.01, 0.0), rotation_deg: (0.0, 35.0, 0.0)), children: [
            (id: "4b8d2f6a0c13e579", name: "flame", transform: (position: (0.0, 0.55, 0.0)), light: (color: (1.0, 0.52, 0.2), intensity: 3.5, range: 7.0)),
        ]),

        // Третий — потухший: экземпляр переопределяет материал корня, не
        // трогая префаб. Уголёк при этом остаётся угольком: глубже корня
        // переопределений пока нет, и это сказано вслух в prefab.rs.
        (
            id: "c44de981a70fc440",
            name: "cold fire",
            model: "",
            prefab: "campfire",
            transform: (position: (0.0, 0.01, -3.4), scale: (0.9, 1.0, 0.9)),
            material: "stone",
            children: [
                // А вот это — не часть префаба, а вещь, поставленная рядом:
                // у неё своя строчка в сцене, её можно выделить и подвинуть.
                (id: "5732038f02281156", name: "kettle", model: "builtin:sphere", transform: (position: (0.9, 0.22, 0.5), scale: (0.28, 0.28, 0.28)), material: "stone"),
            ],
        ),
    ],
)
