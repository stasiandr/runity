    view: (position: (0.0, 3.0, 7.0), target: (0.0, 0.6, 0.0), fov_deg: 50.0),
    sun: (hour: 18.5, intensity: 0.6),
    post: (bloom: (intensity: 0.8)),
    entities: [
        (id: "5f0c7d2a9e41b386", name: "lava floor", model: "builtin:plane", transform: (scale: (12.0, 1.0, 12.0)), material: "lava"),
        (id: "c2b94e18a0d7f563", name: "lava ball", model: "builtin:sphere", transform: (position: (0.0, 1.0, 0.0)), material: "lava"),
    ],
