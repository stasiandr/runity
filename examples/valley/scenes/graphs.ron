// Content graphs, side by side: a floor of lava drawn by a shader graph
// (shaders/lava.graph.ron), a ball of it, embers off it by an effect
// graph (shaders/embers.vfx.ron), and a flag waved by a graph's vertex
// stage (shaders/flag.graph.ron). `scene_shot` this after
// touching a graph.
(
    view: (position: (0.0, 3.0, 7.0), target: (0.0, 0.6, 0.0), fov_deg: 50.0),
    sun: (hour: 18.5, intensity: 0.6),
    post: (bloom: (intensity: 0.8)),
    entities: [
        (id: "5f0c7d2a9e41b386", name: "lava floor", model: "builtin:plane", transform: (scale: (12.0, 1.0, 12.0)), material: "lava"),
        (id: "c2b94e18a0d7f563", name: "lava ball", model: "builtin:sphere", transform: (position: (0.0, 1.0, 0.0)), material: "lava"),
        (id: "3b7e0c91d45a28f6", name: "flag pole", model: "builtin:cylinder", transform: (position: (-3.2, 1.6, -1.5), scale: (0.08, 3.2, 0.08)), material: (base_color: (0.25, 0.22, 0.2))),
        (id: "a61f28d9c03e7b45", name: "flag", model: "builtin:unity_plane", transform: (position: (-2.45, 2.7, -1.5), rotation_deg: (90.0, 0.0, 0.0), scale: (0.15, 1.0, 0.09)), material: "flag"),
        (id: "9d3e61b0c47a2f58", name: "embers", transform: (position: (0.0, 0.05, 0.0)), particles: (rate: 600.0, size: 0.1, gpu: true, graph: "embers")),
    ],
)
