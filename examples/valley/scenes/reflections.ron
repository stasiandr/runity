// Reflection probes (`runity::reflections`): a courtyard with coloured
// walls, a chrome ball and a polished floor. The probe's box holds them all;
// its picture is what the ball and the floor reflect, bent to the walls by
// box projection. Take the probe out and they reflect the sky's gradient.
(
    view: (position: (0.0, 2.4, 7.5), target: (0.0, 0.9, 0.0), fov_deg: 55.0),
    sun: (hour: 15.0, intensity: 1.0),
    entities: [
        (id: "3f1c9a6e2b7d4058", name: "probe", transform: (position: (0.0, 1.5, 0.0)), reflection_probe: (size: (12.0, 6.0, 16.0))),
        (id: "8a41d2c7e95b3016", name: "floor", model: "builtin:plane", transform: (scale: (12.0, 1.0, 16.0)), material: (base_color: (0.12, 0.12, 0.13), metallic: 0.2, smoothness: 0.9)),
        (id: "c5e07b19f3a24d68", name: "red wall", model: "builtin:cube", transform: (position: (-4.0, 1.5, 0.0), scale: (0.3, 3.0, 8.0)), material: (base_color: (0.75, 0.12, 0.08))),
        (id: "1d9e84a3b6c75f20", name: "blue wall", model: "builtin:cube", transform: (position: (4.0, 1.5, 0.0), scale: (0.3, 3.0, 8.0)), material: (base_color: (0.08, 0.22, 0.7))),
        (id: "6b2f5e0d8c1a9347", name: "back wall", model: "builtin:cube", transform: (position: (0.0, 1.5, -4.0), scale: (8.0, 3.0, 0.3)), material: (base_color: (0.85, 0.8, 0.7))),
