        (id: "29d6e1b05a8c7f43", name: "brushed", model: "builtin:sphere", transform: (position: (1.3, 0.6, 1.0), scale: (1.2, 1.2, 1.2)), material: (base_color: (0.95, 0.75, 0.45), metallic: 1.0, smoothness: 0.6)),
