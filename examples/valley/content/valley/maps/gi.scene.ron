// Global illumination by probes (`scrap::ddgi`): a room 8 × 4 × 8 with a
// red wall and a green one, lit only through a square in its roof. The sun
// falls on a patch of the white floor; everything else in the room is lit
// by that patch and by the walls it lights, bounce after bounce — the red
// and green bleeding onto the floor, the ceiling and the white box. Take
// the volume out and the room is lit by the sky it cannot see.
(
    view: (position: (0.0, 1.7, 3.6), target: (0.0, 1.3, -3.0), fov_deg: 70.0),
    sun: (hour: 13.0, intensity: 2.2),
    sky: (mode: Physical),
    ray_tracing: (sun_shadows: true, sun_rays: 2),
    entities: [
        (id: "0a1d5e6f7b8c9d01", name: "light volume", transform: (position: (0.0, 2.0, 0.0)), irradiance_volume: (size: (7.6, 3.6, 7.6), spacing: 0.9)),
        (id: "0a1d5e6f7b8c9d02", name: "floor", model: "builtin:cube", transform: (position: (0.0, -0.1, 0.0), scale: (8.4, 0.2, 8.4)), material: (base_color: (0.8, 0.8, 0.78), smoothness: 0.2), body: Static, collider: Model),
        (id: "0a1d5e6f7b8c9d03", name: "red wall", model: "builtin:cube", transform: (position: (-4.1, 2.0, 0.0), scale: (0.2, 4.0, 8.4)), material: (base_color: (0.8, 0.1, 0.07), smoothness: 0.1)),
        (id: "0a1d5e6f7b8c9d04", name: "green wall", model: "builtin:cube", transform: (position: (4.1, 2.0, 0.0), scale: (0.2, 4.0, 8.4)), material: (base_color: (0.12, 0.6, 0.15), smoothness: 0.1)),
        (id: "0a1d5e6f7b8c9d05", name: "back wall", model: "builtin:cube", transform: (position: (0.0, 2.0, -4.1), scale: (8.4, 4.0, 0.2)), material: (base_color: (0.8, 0.8, 0.78), smoothness: 0.1)),
        (id: "0a1d5e6f7b8c9d06", name: "front wall", model: "builtin:cube", transform: (position: (0.0, 2.0, 4.1), scale: (8.4, 4.0, 0.2)), material: (base_color: (0.8, 0.8, 0.78), smoothness: 0.1)),
        (id: "0a1d5e6f7b8c9d07", name: "roof back", model: "builtin:cube", transform: (position: (0.0, 4.1, -2.35), scale: (8.4, 0.2, 3.7)), material: (base_color: (0.8, 0.8, 0.78))),
        (id: "0a1d5e6f7b8c9d08", name: "roof front", model: "builtin:cube", transform: (position: (0.0, 4.1, 2.85), scale: (8.4, 0.2, 2.7)), material: (base_color: (0.8, 0.8, 0.78))),
        (id: "0a1d5e6f7b8c9d09", name: "roof left", model: "builtin:cube", transform: (position: (-2.85, 4.1, 0.25), scale: (2.7, 0.2, 1.5)), material: (base_color: (0.8, 0.8, 0.78))),
        (id: "0a1d5e6f7b8c9d0a", name: "roof right", model: "builtin:cube", transform: (position: (2.35, 4.1, 0.25), scale: (3.7, 0.2, 1.5)), material: (base_color: (0.8, 0.8, 0.78))),
        (id: "0a1d5e6f7b8c9d0b", name: "tall box", model: "builtin:cube", transform: (position: (-1.5, 1.1, -1.8), rotation_deg: (0.0, 20.0, 0.0), scale: (1.2, 2.2, 1.2)), material: (base_color: (0.82, 0.82, 0.8), smoothness: 0.15)),
        (id: "0a1d5e6f7b8c9d0c", name: "ball", model: "builtin:sphere", transform: (position: (1.4, 0.6, -0.8), scale: (1.2, 1.2, 1.2)), material: (base_color: (0.85, 0.85, 0.85), smoothness: 0.3)),
    ],
)
