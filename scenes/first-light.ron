// The engine's reference scene: everything it can currently draw, arranged so
// that each thing is checking something.
//
// Nothing here needs an import step — every model is a builtin, so this scene
// opens on a fresh clone with no library and no asset pipeline. That is the
// point of it: the shortest path from `git clone` to a picture.
(
    // Where it is looked at from. In the file so that the headless render,
    // the editor and the walk-around all start from the same place — and so
    // that reframing a shot is an edit to a scene rather than to a tool.
    view: (position: (0.0, 3.4, 12.0), target: (0.0, 1.4, -4.0), fov_deg: 55.0),
    sun: (hour: 9.0, intensity: 1.15),
    fog: (color: (0.62, 0.68, 0.74), start: 18.0, end: 90.0),
    entities: [
        // The ground. Without it nothing has anywhere to stand and every
        // object floats, which was most of what looked wrong before.
        (
            id: "285277708f42c5cd",
            name: "ground",
            model: "builtin:plane",
            transform: (scale: (120.0, 1.0, 120.0)),
            material: "grass",
        ),

        // A row of cones marching away from the camera: the same object at
        // four distances, so fog has to show its work.
        (id: "0bea9a71729ac90f", name: "tree near",   model: "builtin:cone", transform: (position: (-2.2, 0.0,  1.0), scale: (1.6, 3.2, 1.6)), material: "needle"),
        (id: "4eebf9513e698bff", name: "tree mid",    model: "builtin:cone", transform: (position: ( 1.8, 0.0, -6.0), scale: (1.8, 4.0, 1.8)), material: "needle"),
        (id: "8a36f9521a6a74ac", name: "tree far",    model: "builtin:cone", transform: (position: (-4.0, 0.0, -22.0), scale: (2.0, 4.6, 2.0)), material: "needle"),
        (id: "cce8d3772ba8fe1f", name: "tree furthest", model: "builtin:cone", transform: (position: ( 5.0, 0.0, -48.0), scale: (2.2, 5.0, 2.2)), material: "needle"),

        // A box, because flat faces at right angles are where hemisphere
        // ambient is easiest to read: three faces, three different values.
        (
            id: "2e7ef17762ca70f9",
            name: "crate",
            model: "builtin:cube",
            transform: (position: (2.6, 0.5, 2.0), rotation_deg: (0.0, 24.0, 0.0)),
            material: "earth",
            body: Static,
        ),

        // A sphere, which is where a bad normal shows up first.
        (
            id: "8f74bd001ecbe5b1",
            name: "boulder",
            model: "builtin:sphere",
            transform: (position: (-1.4, 0.55, 3.4), scale: (1.1, 1.1, 1.1)),
            material: "stone",
            body: Static,
        ),

        // A campfire built as one thing out of several: the ring of stones
        // and the ember are children of the fire, so moving the fire moves
        // all of it. Placed off the origin and turned, so that a child laid
        // out at its parent's feet has to be rotated into place — which is
        // what tells a hierarchy apart from an offset.
        (
            id: "1e0a82d8db467066",
            name: "campfire",
            model: "builtin:plane",
            transform: (position: (0.7, 0.01, 3.0), rotation_deg: (0.0, 35.0, 0.0), scale: (1.4, 1.0, 1.4)),
            material: "earth",
            children: [
                // The one unlit thing in the scene. It should stay the same
                // colour at dawn and at midnight, and fog should not touch it.
                (
                    id: "d752ecd915d0644c",
                    name: "ember",
                    model: "builtin:sphere",
                    transform: (position: (0.0, 0.18, 0.0), scale: (0.24, 0.24, 0.24)),
                    material: "ember",
                ),
                (id: "18293ab721aa5b84", name: "stone north", model: "builtin:cube", transform: (position: ( 0.0, 0.06, -0.42), scale: (0.18, 0.12, 0.18)), material: "stone"),
                (id: "5e9ee53d50da5ec1", name: "stone south", model: "builtin:cube", transform: (position: ( 0.0, 0.06,  0.42), scale: (0.18, 0.12, 0.18)), material: "stone"),
                (id: "7a88527a14c31080", name: "stone east",  model: "builtin:cube", transform: (position: ( 0.42, 0.06, 0.0), scale: (0.18, 0.12, 0.18)), material: "stone"),
                (id: "3208c50d6bf64c99", name: "stone west",  model: "builtin:cube", transform: (position: (-0.42, 0.06, 0.0), scale: (0.18, 0.12, 0.18)), material: "stone"),
            ],
        ),
    ],
)
