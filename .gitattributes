# Text as LF on every machine: a .scrimport stores a hash of its source's
# bytes, and a CRLF checkout would change every one of them.
* text=auto eol=lf

# The example project's scenes and prefabs merge by entity and field, its
# configs by record and field.
# `cargo run -p scrap-cli -- git-setup examples/showreel` turns the driver on.
examples/showreel/scenes/**/*.ron merge=scrap
examples/showreel/prefabs/**/*.prefab merge=scrap
examples/showreel/configs/**/*.ron merge=scrap
examples/kitchen/** !text !filter !merge !diff
